# Capsule 1 -- lower test environment.
#
# Loaded by scripts/pantry-env on top of the repo-root .env, so shared
# secrets (ANTHROPIC_API_KEY) stay in one place and are never duplicated
# here. Everything below is environment-specific and safe to commit.

PANTRY_ENV_NAME=capsule-1
PANTRY_BACKEND_PORT=8101
PANTRY_FRONTEND_PORT=5101
PANTRY_DB_NAME=pantry_capsule_1

ENVIRONMENT_NAME=capsule-1
DATABASE_URL=postgresql+psycopg://pantry:pantry@localhost:5432/pantry_capsule_1
CORS_ORIGINS=http://localhost:5101

# Sessions issued by one environment shouldn't be valid in another, so each
# gets its own signing key. Local-only value: test envs hold no real secrets.
JWT_SECRET_KEY=capsule-1-local-signing-key-not-a-real-secret
