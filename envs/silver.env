# Silver -- the staging environment.
#
# Loaded by scripts/pantry-env on top of the repo-root .env, so shared
# secrets (ANTHROPIC_API_KEY) stay in one place and are never duplicated
# here. Everything below is environment-specific and safe to commit.

PANTRY_ENV_NAME=silver
PANTRY_BACKEND_PORT=8100
PANTRY_FRONTEND_PORT=5100
PANTRY_DB_NAME=pantry_silver

ENVIRONMENT_NAME=silver
DATABASE_URL=postgresql+psycopg://pantry:pantry@localhost:5432/pantry_silver
CORS_ORIGINS=http://localhost:5100

# Sessions issued by one environment shouldn't be valid in another, so each
# gets its own signing key. Local-only value: staging holds no real secrets.
JWT_SECRET_KEY=silver-local-signing-key-not-a-real-secret
